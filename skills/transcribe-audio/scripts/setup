#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=common.sh
source "$script_dir/common.sh"

usage() {
  cat <<'EOF'
Usage:
  setup [--model NAME]
  setup --status
  setup --list-models

Installs whisper.cpp and ffmpeg through Homebrew when missing, then downloads
and verifies the selected model. The default model is small.en.
EOF
}

model="small.en"
mode="setup"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --model)
      [[ $# -ge 2 ]] || die "--model requires a value"
      model="$2"
      shift 2
      ;;
    --status)
      mode="status"
      shift
      ;;
    --list-models)
      print_models
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

validate_model "$model" || {
  print_models >&2
  die "unsupported model: $model"
}

if [[ "$mode" == "status" ]]; then
  if command -v whisper-cli >/dev/null 2>&1; then
    printf 'whisper-cli: %s\n' "$(command -v whisper-cli)"
  else
    printf 'whisper-cli: missing\n'
  fi
  if command -v ffmpeg >/dev/null 2>&1; then
    printf 'ffmpeg: %s\n' "$(command -v ffmpeg)"
  else
    printf 'ffmpeg: missing\n'
  fi
  printf 'model cache: %s\n' "$(models_dir)"
  found=0
  for candidate in tiny.en base.en small.en medium.en small medium large-v3-turbo-q5_0; do
    candidate_path="$(model_path "$candidate")"
    if [[ -f "$candidate_path" ]]; then
      found=1
      if verify_model "$candidate" "$candidate_path"; then
        printf 'model %s: ready\n' "$candidate"
      else
        printf 'model %s: checksum mismatch\n' "$candidate"
      fi
    fi
  done
  [[ $found -eq 1 ]] || printf 'models: none installed\n'
  exit 0
fi

missing_formulae=()
command -v whisper-cli >/dev/null 2>&1 || missing_formulae+=(whisper-cpp)
command -v ffmpeg >/dev/null 2>&1 || missing_formulae+=(ffmpeg)

if [[ ${#missing_formulae[@]} -gt 0 ]]; then
  command -v brew >/dev/null 2>&1 || die "Homebrew is required to install: ${missing_formulae[*]}. Install Homebrew with user approval, then rerun setup."
  printf 'Installing with Homebrew: %s\n' "${missing_formulae[*]}"
  brew install "${missing_formulae[@]}"
fi

command -v curl >/dev/null 2>&1 || die "curl is required to download the model"

destination_dir="$(models_dir)"
destination="$(model_path "$model")"
mkdir -p "$destination_dir"

if [[ -f "$destination" ]]; then
  if verify_model "$model" "$destination"; then
    printf 'Model %s is already installed and verified: %s\n' "$model" "$destination"
    printf 'Setup complete.\n'
    exit 0
  fi
  die "existing model has the wrong checksum: $destination (move or remove it, then rerun setup)"
fi

temporary="$(mktemp "$destination_dir/.ggml-$model.XXXXXX")"
cleanup() {
  if [[ -n "${temporary:-}" && -f "$temporary" ]]; then
    rm -f -- "$temporary"
  fi
}
trap cleanup EXIT INT TERM

url="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-$model.bin"
printf 'Downloading model %s to %s\n' "$model" "$destination"
curl -L --fail --retry 5 --retry-delay 5 --retry-all-errors --output "$temporary" "$url"

verify_model "$model" "$temporary" || die "downloaded model failed checksum verification"
mv -- "$temporary" "$destination"
temporary=""
printf 'Installed and verified model %s: %s\n' "$model" "$destination"
printf 'Setup complete.\n'
